# Copy to `.env` (gitignored) and fill in for the spike / local testing.
# NEVER commit real keys. The MCP server reads creds from local config/env,
# never from agent tool arguments.

# Throwaway Supabase project (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# New key model (Project Settings -> API Keys). NOT the legacy anon/service_role JWTs.
# - publishable: client-safe, RLS-bounded; rides in the public share link (page-service).
# - secret:      full DB access; used by the MCP server, stays in local config.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Schema setup is done OUT OF BAND (SQL editor, or `supabase db push` / Supabase MCP) —
# the tool never runs DDL, so no Management API token is needed.
