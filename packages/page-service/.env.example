# Page-service config — copy to `.env.local` for your deployment.
# The page-service holds NO Supabase keys: the publishable key arrives with each
# share link, and submissions write directly to the survey owner's Supabase.

# --- Branding (optional) — your hosted instance's skin ---
BRAND_NAME=Agentic Survey
# BRAND_LOGO_URL=https://your.cdn/logo.svg
# BRAND_URL=https://your-landing-page.example

# --- Bot protection (optional) — Cloudflare Turnstile ---
# Leave unset to disable (submissions still rate-limited per IP).
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
