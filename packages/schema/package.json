{
  "name": "@agentic-survey/schema",
  "version": "0.1.0",
  "description": "SQL migration + shared TypeScript types for the survey data model.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -b"
  }
}
